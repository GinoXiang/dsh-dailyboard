{
  "name": "dsh-dailyboard",
  "version": "1.0.9",
  "description": "DailyBoard — a daily work task board for the DSH Web GUI: a one-month calendar with colored timeline bars, a daily checklist, week and day views with a draggable 24-hour timeline, weekly/interval recurring tasks with per-day result records, a long-term progress entry in the calendar header, a collapsible daily email reminder for any mailbox, and AI task extraction from natural language.",
  "license": "MIT",
  "author": "GinoXiang",
  "homepage": "https://github.com/GinoXiang/dsh-dailyboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GinoXiang/dsh-dailyboard.git"
  },
  "bugs": {
    "url": "https://github.com/GinoXiang/dsh-dailyboard/issues"
  },
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "dailyboard",
    "task",
    "tasks",
    "todo",
    "calendar",
    "timeline",
    "task-manager"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
